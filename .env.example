# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://ainp:ainp@localhost:5432/ainp
# 64 hex chars (32 bytes). Encrypts integration credentials at rest. `openssl rand -hex 32`
ENCRYPTION_KEY=
# Session signing secret. `openssl rand -hex 32`
JWT_SECRET=
APP_URL=http://localhost:5173      # where users open the web app
API_URL=http://localhost:4000      # public URL of the API (OAuth callbacks, webhooks, email tracking)
PORT=4000
STORAGE_DIR=./storage              # uploaded receipts/attachments (use a mounted volume in production)
RUN_JOBS=true                      # set false on web replicas if you run a dedicated worker

# ── AI (optional) — enables Ask A.I. Nonprofits free-form answers and AI drafting ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Email delivery (optional; users can also connect their own Gmail) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Org <giving@example.org>"

# ── QuickBooks Online (Intuit developer app) ──
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox            # sandbox | production
# Redirect URI to register: ${API_URL}/api/integrations/quickbooks/callback

# ── Google (Gmail send + Calendar events) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: ${API_URL}/api/integrations/google/callback
GOOGLE_MAPS_API_KEY=               # optional: precise donor geocoding for trip planning

# ── Bank feeds (Plaid) ──
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Stripe / Square / PayPal credentials are entered per organization in
# Money › Accounting › Integrations (stored encrypted), not here.
