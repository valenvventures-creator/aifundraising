# A.I. Fundraising - environment variables.
# On Netlify, set these under Site configuration -> Environment variables. Never commit real values.

# ── Database ──────────────────────────────────────────────
# On Netlify: provided automatically as NETLIFY_DB_URL when Netlify Database is enabled (same as
# the other Thought Authorities sites). Set DATABASE_URL only for local development or another host.
# NETLIFY_DB_URL=
DATABASE_URL=postgres://ainp:ainp@localhost:5432/ainp

# ── Keys ──────────────────────────────────────────────────
# Optional on Netlify: if unset, each is generated once and kept in a private Netlify Blobs store.
# Required on other hosts. Generate with: openssl rand -hex 32
# ENCRYPTION_KEY encrypts saved integration credentials - never change it once data exists.
ENCRYPTION_KEY=
JWT_SECRET=
APP_URL=http://localhost:5173      # where users open the web app
API_URL=http://localhost:4000      # public URL of the API (OAuth callbacks, webhooks, email tracking)
PORT=4000
STORAGE_DIR=./storage              # uploaded receipts/attachments (use a mounted volume in production)
RUN_JOBS=true                      # set false on web replicas if you run a dedicated worker

# ── AI (optional) — enables Ask A.I. Fundraising free-form answers and AI drafting ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Email via Resend (same names as the other Thought Authorities sites). Optional. ──
# Enables password-reset, invitation, receipt and campaign emails. EMAIL_FROM must use a domain
# verified in Resend, e.g. "A.I. Fundraising <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Email via SMTP (alternative to Resend; users can also connect their own Gmail) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Org <giving@example.org>"

# ── QuickBooks Online (Intuit developer app) ──
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox            # sandbox | production
# Redirect URI to register: ${API_URL}/api/integrations/quickbooks/callback

# ── Google (Gmail send + Calendar events) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: ${API_URL}/api/integrations/google/callback
GOOGLE_MAPS_API_KEY=               # optional: precise donor geocoding for trip planning

# ── Bank feeds (Plaid) ──
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Stripe / Square / PayPal credentials are entered per organization in
# Money › Accounting › Integrations (stored encrypted), not here.

# ── One-click Stripe (Stripe Connect OAuth). Optional; without it, organizations paste their own keys. ──
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── One-click Square (Square OAuth). Optional. SQUARE_ENVIRONMENT = production | sandbox ──
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=production
